    {
      "id": "4672ce7a-bde5-437b-82fb-52e0ac2bccdc",
      "name": "Linhas da automação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2912,
        272
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Monta as linhas de métricas (foto da hora) e de nodes (dimensão) de UMA automação.\n// Contrato: docs/contrato-dados.md (unnichat_automacoes_metricas / unnichat_automacoes_nodes).\n// A API REST responde { success, data: {...} }.\n// Automação que nunca mandou mensagem não grava foto (zerada fica fora).\n// O detalhe só é buscado quando há node de template; aqui só vale se for desta automação.\nconst cfg = $('Config').first().json;\nconst a = $('Loop automações').first().json;\nconst mResp = $('Métricas').first().json;\nconst m = mResp?.data ?? mResp?.metrics ?? mResp ?? {};\nconst int = (v) => { const n = Number(v); return v === null || v === undefined || v === '' || !Number.isFinite(n) ? null : Math.round(n); };\nconst tot = m.totals?.messages ?? {};\nif (!(int(tot.sent) > 0)) return [{ json: { _tabela: 'zerada', automacao_id: a.automacao_id } }];\n\nlet det = {};\ntry { const d = $('Detalhe').first().json; const dd = d?.data ?? d?.automation ?? d ?? {}; if (dd.id === a.automacao_id) det = dd; } catch (e) { det = {}; }\nconst coletadoEm = DateTime.now().setZone(cfg.fuso).startOf('hour').toISO();\nconst agora = DateTime.now().toISO();\n\n// templates: nome -> categoria (MARKETING / UTILITY / AUTHENTICATION)\nconst lista = (b) => Array.isArray(b) ? b : (b?.data ?? b?.items ?? b?.templates ?? []);\nconst cat = {};\nfor (const t of $('Listar templates').all().flatMap(i => lista(i.json))) if (t?.name) cat[String(t.name).trim().toLowerCase()] = t.category ?? null;\n\n// nodes do detalhe, por id (o nome do template fica no text do node)\nconst porId = {};\nfor (const n of (Array.isArray(det.nodes) ? det.nodes : [])) { const id = n?.id ?? n?.nodeId; if (id) porId[id] = n; }\nconst nomeTemplate = (n) => {\n  if (!n) return null;\n  for (const v of [n.text, n.data?.template?.name, n.data?.templateName, n.template?.name, n.templateName]) {\n    if (typeof v === 'string' && v.trim()) return v.trim();\n  }\n  return null;\n};\n\nconst base = { automacao_id: a.automacao_id, automacao_nome: m.name ?? a.automacao_nome, pasta: a.pasta };\nconst out = [];\nout.push({ _tabela: 'm', coletado_em: coletadoEm, ...base, node_id: '_total', automacao_ativa: a.automacao_ativa,\n  node_tipo: '_total', message_type: null, conexao: cfg.conexao,\n  enviados: int(tot.sent), entregues: int(tot.delivered), lidos: int(tot.read), falhas: int(tot.failed), raw_payload: mResp });\n\nfor (const n of (m.nodes ?? [])) {\n  if (!n?.messages) continue;\n  const mt = n.messageType ?? null;\n  out.push({ _tabela: 'm', coletado_em: coletadoEm, ...base, node_id: n.nodeId, automacao_ativa: a.automacao_ativa,\n    node_tipo: n.type ?? null, message_type: mt, conexao: cfg.conexao,\n    enviados: int(n.messages.sent), entregues: int(n.messages.delivered), lidos: int(n.messages.read), falhas: int(n.messages.failed), raw_payload: n });\n  const ehTemplate = mt === 'send_template';\n  const tNome = ehTemplate ? nomeTemplate(porId[n.nodeId]) : null;\n  const tCat = tNome ? (cat[tNome.toLowerCase()] ?? null) : null;\n  out.push({ _tabela: 'n', ...base, node_id: n.nodeId, node_tipo: n.type ?? null, message_type: mt,\n    template_nome: tNome, template_categoria: tCat, categoria_cobranca: ehTemplate ? tCat : 'SERVICE',\n    raw_payload: { metricas: n, detalhe: porId[n.nodeId] ?? null }, visto_em: agora });\n}\nreturn out.map(j => ({ json: j }));"
      }
    },

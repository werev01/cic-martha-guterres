    {
      "id": "c1a0ca5b-15eb-4add-880a-5c21446f655d",
      "name": "Selecionar automações",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Acha a pasta raiz (config) e todas as descendentes; mantém só as automações dessas pastas.\n// A API REST responde { success, data: [...], metadata, links }.\nconst cfg = $('Config').first().json;\nconst lista = (b) => Array.isArray(b) ? b : (b?.data ?? b?.items ?? b?.folders ?? b?.automations ?? []);\nconst pastas = $('Listar pastas').all().flatMap(i => lista(i.json));\nconst raizes = pastas.filter(p => p.name === cfg.pasta_raiz && !p.parentId);\nif (raizes.length !== 1) throw new Error('Coleta de automações: pasta raiz \"' + cfg.pasta_raiz + '\" encontrada ' + raizes.length + ' vezes (esperado 1). Pastas lidas: ' + pastas.length);\nconst nomePasta = {};\nconst dentro = new Set([raizes[0].id]);\nnomePasta[raizes[0].id] = raizes[0].name;\nlet mudou = true;\nwhile (mudou) {\n  mudou = false;\n  for (const p of pastas) if (p.parentId && dentro.has(p.parentId) && !dentro.has(p.id)) { dentro.add(p.id); nomePasta[p.id] = p.name; mudou = true; }\n}\nconst autos = $('Listar automações').all().flatMap(i => lista(i.json)).filter(a => dentro.has(a.folderId));\nif (!autos.length) throw new Error('Coleta de automações: nenhuma automação nas pastas de ' + cfg.pasta_raiz);\nreturn autos.map(a => ({ json: {\n  automacao_id: a.id,\n  automacao_nome: a.name ?? null,\n  pasta: nomePasta[a.folderId] ?? null,\n  automacao_ativa: typeof a.active === 'boolean' ? a.active : null\n} }));"
      }
    },
    {
      "id": "6bc1af50-0f12-405e-bf41-11f0b726c9f8",
      "name": "Loop automações",
      "type": "n8n-nodes-base.splitInBatches",

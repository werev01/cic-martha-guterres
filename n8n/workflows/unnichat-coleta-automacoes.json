    {
      "id": "00b3f9a1-da0e-4bb6-9c97-9e8de15051b7",
      "name": "Lotes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Separa as linhas por tabela e monta lotes de até 500 pro upsert no PostgREST.\n// t = templates da conta (já baixados em 'Listar templates', sem chamada extra).\nconst base = 'https://zrvrfxhzwzumvetgjure.supabase.co/rest/v1/';\nconst destinos = {\n  m: base + 'unnichat_automacoes_metricas?on_conflict=automacao_id,node_id,coletado_em',\n  n: base + 'unnichat_automacoes_nodes?on_conflict=automacao_id,node_id',\n  t: base + 'unnichat_templates?on_conflict=template_id'\n};\nconst grupos = { m: [], n: [], t: [] };\nfor (const i of $input.all()) { const { _tabela, ...row } = i.json; if (grupos[_tabela]) grupos[_tabela].push(row); }\nconst lista = (b) => Array.isArray(b) ? b : (b?.data ?? b?.items ?? b?.templates ?? []);\nconst agora = DateTime.now().toISO();\nconst vistos = new Set();\nfor (const t of $('Listar templates').all().flatMap(i => lista(i.json))) {\n  if (!t?.id || !t?.name || vistos.has(String(t.id))) continue;\n  vistos.add(String(t.id));\n  grupos.t.push({ template_id: String(t.id), nome: t.name, categoria: t.category ?? null, idioma: t.language ?? null, status: t.status ?? null, raw_payload: t, visto_em: agora });\n}\nconst out = [];\nfor (const k of Object.keys(grupos)) for (let x = 0; x < grupos[k].length; x += 500) out.push({ json: { url: destinos[k], linhas: grupos[k].length, body: grupos[k].slice(x, x + 500) } });\nreturn out;"
      }
    },

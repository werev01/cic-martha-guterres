    {
      "id": "c7f79ed8-3060-4f80-8eb0-63e4c30b1f43",
      "name": "Lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Junta as linhas num array só (até 500) pro upsert.\nconst linhas = $input.all().map(i => i.json).filter(j => j.broadcast_id);\nconst out = [];\nfor (let x = 0; x < linhas.length; x += 500) out.push({ json: { body: linhas.slice(x, x + 500) } });\nreturn out;"
      }
    },

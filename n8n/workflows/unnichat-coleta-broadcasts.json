    {
      "id": "e92f6ae4-8b63-4c47-a83c-75546d457bc7",
      "name": "Selecionar broadcasts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Filtra os broadcasts comerciais que começaram a enviar e decide quem precisa de /metrics.\n// Regra de recoleta: não está no banco, ou status mudou, ou não está em status final,\n// ou não tem finishedAt, ou finalizou há menos de N horas (config).\nconst cfg = $('Config').first().json;\nconst lista = (b) => Array.isArray(b) ? b : (b?.data ?? b?.items ?? []);\nconst prefixos = (cfg.prefixos || []).map(p => String(p).toLowerCase());\nconst todos = $('Listar broadcasts').all().flatMap(i => lista(i.json));\nconst vistos = new Set();\nconst banco = {};\nfor (const i of $('Ler banco').all()) if (i.json?.broadcast_id) banco[i.json.broadcast_id] = i.json;\nconst limite = DateTime.now().minus({ hours: cfg.recoleta_horas });\nconst finais = new Set(cfg.status_finais || []);\nconst out = [];\nfor (const b of todos) {\n  if (!b?.id || vistos.has(b.id)) continue;\n  vistos.add(b.id);\n  const nome = String(b.name ?? '').toLowerCase();\n  if (!prefixos.some(p => nome.startsWith(p))) continue;\n  if (!b.startedAt || !(Number(b.contactsAmount) > 0)) continue;   // zerado: fica fora até começar a enviar\n  const db = banco[b.id];\n  const fim = b.finishedAt ? DateTime.fromISO(b.finishedAt) : null;\n  const recoleta = !db || db.status !== b.status || !finais.has(b.status) || !fim || fim > limite;\n  if (recoleta) out.push({ json: { broadcast_id: b.id } });\n}\nreturn out;"
      }
    },

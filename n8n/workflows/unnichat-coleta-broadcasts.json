    {
      "id": "279ed65c-2302-417f-8ede-d3cef064d6b0",
      "name": "Mapear broadcast",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        272
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// /broadcasts/{id}/metrics -> public.unnichat_broadcasts. Contrato: docs/contrato-dados.md.\n// tpl_* = nodes de template (type send_template ou templateId preenchido) + primeiro passo se for template.\n// srv_* = demais nodes de mensagem (sessão). template_id = id da Meta do primeiro node de template.\nconst resp = $('Métricas').first().json;\nconst b = resp?.data ?? resp?.metrics ?? resp ?? {};\nconst m = b.metrics ?? {};\nconst int = (v) => { const n = Number(v); return v === null || v === undefined || v === '' || !Number.isFinite(n) ? 0 : Math.round(n); };\nconst ts = (v) => { if (!v) return null; const d = DateTime.fromISO(String(v)); return d.isValid ? d.toISO() : null; };\nconst soma = { tpl: { s: 0, d: 0, r: 0, f: 0 }, srv: { s: 0, d: 0, r: 0, f: 0 } };\nconst add = (k, n) => { soma[k].s += int(n.sent); soma[k].d += int(n.delivered); soma[k].r += int(n.read); soma[k].f += int(n.failed); };\nlet templateId = null;\nif (b.firstStepType === 'template' && m.firstStep) add('tpl', m.firstStep);\nfor (const n of (m.nodes ?? [])) {\n  const ehTpl = n.type === 'send_template' || (n.templateId !== null && n.templateId !== undefined && n.templateId !== '');\n  add(ehTpl ? 'tpl' : 'srv', n);\n  if (ehTpl && !templateId && n.templateId) templateId = String(n.templateId);\n}\nreturn [{ json: {\n  broadcast_id: b.id ?? $('Loop broadcasts').first().json.broadcast_id,\n  nome: b.name ?? null,\n  status: b.status ?? null,\n  contatos: b.contactsAmount ?? null,\n  send_at: ts(b.sendAt), started_at: ts(b.startedAt), finished_at: ts(b.finishedAt),\n  template_id: templateId,\n  tpl_enviados: soma.tpl.s, tpl_entregues: soma.tpl.d, tpl_lidos: soma.tpl.r, tpl_falhas: soma.tpl.f,\n  srv_enviados: soma.srv.s, srv_entregues: soma.srv.d, srv_lidos: soma.srv.r, srv_falhas: soma.srv.f,\n  raw_payload: resp\n} }];"
      }
    }

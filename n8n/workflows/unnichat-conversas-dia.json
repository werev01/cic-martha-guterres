    {
      "name": "Aplicar atendente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Fallback: sem prefixo [Nome] no dia, vendedor = atendente atribuído agora.\n// API REST: { success, data: { id, name, email } } (data com nulos = sem atendente).\nconst row = { ...$('Contar do dia').first().json };\nconst r = $('Atendente atribuído').first().json ?? {};\nconst nome = r?.data?.name ?? r?.data?.attendant?.name ?? r?.attendant?.name ?? null;\nrow.vendedor = nome;\nrow.raw_payload = { ...row.raw_payload, vendedor_fonte: nome ? 'assign' : null };\nreturn [{ json: row }];"
      }
    },
    {
      "name": "Lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Só contato com pelo menos 1 mensagem no dia; lotes de até 500 pro upsert.\nconst linhas = $input.all().map(i => i.json).filter(j => !j._skip && j.contact_id).map(({ _precisa_assign, _skip, ...r }) => r);\nconst out = [];\nfor (let x = 0; x < linhas.length; x += 500) out.push({ json: { linhas: linhas.length, body: linhas.slice(x, x + 500) } });\nreturn out;"
      }
    },

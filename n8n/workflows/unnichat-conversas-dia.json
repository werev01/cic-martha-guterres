    {
      "name": "Universo do dia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Junta, sem repetir, os contatos com negócio aberto nas 5 colunas e os que tiveram evento de CRM no dia.\nconst lista = (b) => Array.isArray(b) ? b : (b?.data ?? b?.items ?? []);\nconst mapa = new Map();\nfor (const i of $('Listar negócios').all()) for (const d of lista(i.json)) {\n  if (d?.contactId && !mapa.has(d.contactId)) mapa.set(d.contactId, { contact_id: d.contactId, telefone: d.phoneNumber ?? null, fonte: 'pipeline' });\n}\nfor (const i of $('Contatos com evento').all()) {\n  const c = i.json?.contact_id;\n  if (c && !mapa.has(c)) mapa.set(c, { contact_id: c, telefone: i.json.telefone ?? null, fonte: 'evento' });\n}\nreturn [...mapa.values()].map(j => ({ json: j }));"
      }
    },

                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ (() => { const b = $response.body ?? {}; const ms = Array.isArray(b.data) ? b.data : (b.data?.messages ?? b.messages ?? []); const nb = b.metadata?.nextBefore ?? b.data?.nextBefore ?? b.nextBefore; return !nb || !ms.length || String(ms[0].date) < $('Preparar dia').first().json.inicio_utc; })() }}",
              "limitPagesFetched": true,
              "maxRequests": 40,
              "requestInterval": 300
            }
          }
        }
      }

    {
      "name": "Preparar dia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Define o dia (parâmetro do reprocessamento ou hoje em SP) e as colunas do pipeline a listar.\nconst cfg = $('Config').first().json;\nconst p = String(cfg.dia_param || '').trim();\nconst d = p ? DateTime.fromISO(p, { zone: cfg.fuso }) : DateTime.now().setZone(cfg.fuso);\nif (!d.isValid || (p && !/^\\d{4}-\\d{2}-\\d{2}$/.test(p))) throw new Error('Conversas do dia: parâmetro dia inválido (use YYYY-MM-DD): ' + p);\nconst inicio = d.startOf('day');\nconst base = { dia: inicio.toFormat('yyyy-MM-dd'), inicio_utc: inicio.toUTC().toISO(), fim_utc: inicio.plus({ days: 1 }).toUTC().toISO() };\nreturn (cfg.colunas || []).map(c => ({ json: { ...base, column_id: c } }));"
      }
    },

        }
      },
      "parameters": {
        "method": "GET",
        "url": "https://zrvrfxhzwzumvetgjure.supabase.co/rest/v1/unnichat_eventos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "telefone,contact_id:raw_payload->data->>id"
            },
            {
              "name": "and",
              "value": "={{ \"(event_ts.gte.\" + $('Preparar dia').first().json.inicio_utc + \",event_ts.lt.\" + $('Preparar dia').first().json.fim_utc + \")\" }}"

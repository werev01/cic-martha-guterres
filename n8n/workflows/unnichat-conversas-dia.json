    {
      "name": "Contar do dia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Conta as mensagens do dia do contato por quem enviou (regra aprovada em 05/11/2026).\n// Contrato: docs/contrato-dados.md (unnichat_conversas_dia). Não guarda texto de mensagem.\n// API REST: { success, data: [ { id, date, type, origin?, senderBy, message?, templateCategory? } ], metadata: { nextBefore } }\n// Template do vendedor: MARKETING em tpl_vendedor_mkt; UTILITY, AUTHENTICATION e sem categoria em tpl_vendedor_utl.\nconst dia = $('Preparar dia').first();\nconst c = $('Loop contatos').first().json;\nconst ini = dia.json.inicio_utc, fim = dia.json.fim_utc;\nconst vistos = new Set();\nconst msgs = [];\nfor (const i of $('Mensagens').all()) {\n  const b = i.json ?? {};\n  const lista = Array.isArray(b.data) ? b.data : (b.data?.messages ?? b.messages ?? []);\n  for (const m of lista) { if (m?.id && !vistos.has(m.id)) { vistos.add(m.id); msgs.push(m); } }\n}\nconst cols = ['msg_vendedor', 'msg_agendada', 'tpl_vendedor_utl', 'tpl_vendedor_mkt', 'msg_automacao', 'tpl_automacao', 'msg_lead', 'msg_sistema'];\nconst cont = Object.fromEntries(cols.map(k => [k, 0]));\nconst ids = Object.fromEntries(cols.map(k => [k, []]));\nconst tplCat = { vendedor: {}, automacao: {} };\nconst origensDesconhecidas = {};\nconst nomes = {};\nfor (const m of msgs) {\n  const dt = String(m.date ?? '');\n  if (!(dt >= ini && dt < fim)) continue;\n  const quem = m.senderBy ?? m.sender;\n  const origem = m.origin ?? null;\n  const tpl = m.type === 'template';\n  const cat = m.templateCategory ?? 'SEM_CATEGORIA';\n  let col;\n  if (quem === 'contact') col = 'msg_lead';\n  else if (quem === 'platform') col = 'msg_sistema';\n  else if (quem === 'user') {\n    if (origem === 'automation') col = tpl ? 'tpl_automacao' : 'msg_automacao';\n    else if (origem === 'schedule') col = 'msg_agendada';\n    else if (origem === null || origem === '') col = tpl ? (cat === 'MARKETING' ? 'tpl_vendedor_mkt' : 'tpl_vendedor_utl') : 'msg_vendedor';\n    else { col = 'msg_automacao'; origensDesconhecidas[origem] = (origensDesconhecidas[origem] || 0) + 1; }\n    if (col === 'msg_vendedor' || col === 'msg_agendada') {\n      const r = /^\\[([^\\]]+)\\]/.exec(String(m.message ?? m.text ?? '').trim());\n      if (r) nomes[r[1].trim()] = (nomes[r[1].trim()] || 0) + 1;\n    }\n    if (tpl) { const g = col.startsWith('tpl_vendedor') ? 'vendedor' : 'automacao'; tplCat[g][cat] = (tplCat[g][cat] || 0) + 1; }\n  } else { col = 'msg_sistema'; origensDesconhecidas['senderBy:' + quem] = (origensDesconhecidas['senderBy:' + quem] || 0) + 1; }\n  cont[col]++; ids[col].push(m.id);\n}\nconst total = cols.reduce((s, k) => s + cont[k], 0);\nif (!total) return [{ json: { _skip: true } }];\nconst vendedor = Object.entries(nomes).sort((a, b) => b[1] - a[1])[0]?.[0] ?? null;\nreturn [{ json: {\n  dia: dia.json.dia, contact_id: c.contact_id, telefone: c.telefone ?? null, vendedor,\n  ...cont,\n  raw_payload: { contagens: cont, ids, templates_por_categoria: tplCat, vendedor_fonte: vendedor ? 'prefixo' : null, nomes_prefixo: nomes, origens_desconhecidas: origensDesconhecidas, universo: c.fonte, total },\n  _precisa_assign: !vendedor\n} }];"
      }
    },

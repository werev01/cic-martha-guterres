      "name": "Mapear dias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "// GET /analytics/dashboard?granularity=day -> public.unnichat_painel_dia (upsert por conexao, dia).\nconst r = $input.first().json;\nconst b = r?.data ?? r?.summary ?? r;\nconst serie = b?.series ?? b?.summary?.series ?? [];\nconst conexao = $('Config').first().json.conexao;\nconst int = (v) => (v === null || v === undefined || v === '' || !Number.isFinite(Number(v))) ? null : Math.round(Number(v));\nconst linhas = serie.filter(d => d?.date).map(d => ({\n  conexao, dia: String(d.date).slice(0, 10),\n  mensagens_recebidas: int(d.messagesReceived), conversas: int(d.conversations), contatos_criados: int(d.contactsCreated),\n  templates_utility: int(d.templatesUtility), templates_marketing: int(d.templatesMarketing),\n  raw_payload: d, coletado_em: new Date().toISOString()\n}));\nif (!linhas.length) throw new Error('Painel do Unnichat sem série diária: ' + JSON.stringify(r).slice(0, 300));\nreturn [{ json: { body: linhas } }];"
      }
    },
